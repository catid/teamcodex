{
  "proxy": {
    "host": "127.0.0.1",
    "port": 1456,
    "apiKey": "tcx-replace-with-a-generated-secret"
  },
  "upstream": "https://chatgpt.com",
  "apiUpstream": "https://api.openai.com",
  "switchThreshold": 0.98,
  "autoReset": {
    "enabled": true,
    "threshold": 0.98,
    "pollIntervalSeconds": 300
  },
  "accounts": [
    {
      "name": "primary",
      "type": "chatgpt",
      "importFrom": "~/.codex/auth.json",
      "weight": 1,
      "enabled": true,
      "switchThreshold": 0.98
    }
  ],
  "retry": {
    "maxRetries": 2,
    "headerTimeoutSeconds": 60,
    "idleTimeoutSeconds": 120
  },
  "maxConcurrentRequests": 100,
  "routing": {
    "defaultPool": "main",
    "pools": {
      "main": {
        "accounts": [
          "primary"
        ],
        "strategy": "weighted-round-robin",
        "switchThreshold": 0.98,
        "maxConcurrentRequests": 50
      }
    }
  }
}
