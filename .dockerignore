# Deny by default. These are the only inputs used by our Dockerfiles.
**
!package.json
!bun.lock
!bunfig.toml
!apps/
!apps/cli/
!apps/cli/package.json
!apps/cli/src/
!apps/cli/src/**/*.ts
!packages/
!packages/*/
!packages/*/package.json
!packages/*/src/
!packages/*/src/**/*.ts
!test/
!packages/*/test/
!packages/*/test/**/*.ts
!apps/cli/test/
!apps/cli/test/**/*.ts
!teamcodex.sh
!scripts/
!scripts/errors.sh
!scripts/resume.py
!scripts/update.py
!test/test_*.py

# Defense in depth: never send credentials or generated artifacts in allowed trees.
**/node_modules/**
**/.env
**/.env.*
**/auth.json
**/*.log
**/__pycache__/**
**/*.pyc
