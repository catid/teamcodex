{
  "name": "teamcodex",
  "version": "1.0.0",
  "description": "Multi-account Codex proxy with automatic quota-based rotation",
  "type": "module",
  "main": "apps/cli/src/index.ts",
  "bin": {
    "teamcodex": "apps/cli/src/index.ts"
  },
  "files": [
    "apps/cli/src/",
    "packages/"
  ],
  "scripts": {
    "start": "bun apps/cli/src/index.ts",
    "test": "bun test packages/shared/test packages/core/test packages/proxy/test apps/cli/test",
    "lint": "bun node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "knip": "bun node_modules/knip/bin/knip.js",
    "check": "bun run errors:check && bun run typecheck && bun run lint && bun run knip && bun test packages/shared/test && bun test packages/core/test && bun test packages/proxy/test && bun test apps/cli/test",
    "errors:generate": "bun scripts/generate-errors.ts",
    "errors:check": "bun scripts/generate-errors.ts --check",
    "test:e2e": "bun test e2e/docker.test.ts",
    "lint:fix": "bun node_modules/eslint/bin/eslint.js . --fix --max-warnings 0",
    "test:tui": "bun test e2e/tui.test.ts",
    "test:oauth": "bun test e2e/oauth.test.ts",
    "test:coverage": "bun test --coverage packages/shared/test packages/core/test packages/proxy/test apps/cli/test",
    "typecheck": "bun node_modules/@typescript/native/bin/tsc --build",
    "test:core": "bun test packages/core/test",
    "test:proxy": "bun test packages/proxy/test",
    "test:cli": "bun test apps/cli/test"
  },
  "keywords": [
    "codex",
    "openai",
    "chatgpt",
    "proxy",
    "load-balancer",
    "multi-account"
  ],
  "license": "MIT",
  "engines": {
    "bun": "1.4.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@xterm/xterm": "6.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.12.0",
    "knip": "6.35.1",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "@types/bun": "1.4.2",
    "typescript-eslint": "8.70.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/node": "26.5.1"
  },
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "@types/node": "26.5.1"
  },
  "dependencies": {
    "@teamcodex/core": "workspace:*",
    "@teamcodex/proxy": "workspace:*",
    "@teamcodex/shared": "workspace:*"
  }
}
