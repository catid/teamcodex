{
  "$schema": "https://unpkg.com/knip@6.35.1/schema.json",
  "ignoreBinaries": [
    "codex",
    "xdg-open"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "e2e/mock-provider.ts",
        "e2e/redirect-auth.ts",
        "e2e/oauth-transport.ts",
        "e2e/backpressure.ts",
        "e2e/*.test.ts"
      ],
      "project": [
        "e2e/**/*.ts",
        "scripts/**/*.ts"
      ]
    },
    "packages/core": {
      "entry": [
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "packages/proxy": {
      "entry": [
        "src/healthcheck.ts",
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "apps/cli": {
      "entry": [
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "packages/shared": {
      "entry": [
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    }
  }
}
