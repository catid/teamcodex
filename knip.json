{
  "$schema": "https://unpkg.com/knip@6.35.1/schema.json",
  "ignoreBinaries": [
    "codex",
    "xdg-open"
  ],
  "ignoreDependencies": [
    "@xterm/xterm"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "src/healthcheck.js",
        "e2e/mock-provider.js",
        "e2e/redirect-auth.js",
        "e2e/oauth-transport.js",
        "e2e/backpressure.js"
      ],
      "project": [
        "src/**/*.js",
        "test/**/*.js",
        "e2e/**/*.js",
        "scripts/**/*.ts"
      ]
    },
    "packages/core": {
      "entry": [
        "src/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "packages/proxy": {
      "entry": [
        "src/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "apps/cli": {
      "entry": [
        "src/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    }
  }
}
